p="$FTL_CFG/etags" ; file="${1#etags }"

[[ -f "$p/$file" ]] &&
	{ . "$p/$file" $fs ; etag1=1 ; etag1_name=$(etag_name) ; cdir ; } || 
	{ file="$(cd $p ; fd | fzf-tmux -p 50% --reverse --info=inline)" ; [[ "$file" ]] && { . "$p/$file" $fs ; etag1=1 ; etag1_name=$(etag_name) ; cdir ; } ; }

