ftl::plugin::core::open_with()
{
	local players
	players=$( < <( cat <<EOF
cbr	zathura
cbz	zathura
application/vnd.comicbook-rar	zathura
cbr	mcomix
cbz	mcomix
application/vnd.comicbook-rar	mcomix
EOF
) rg -F -f <(echo -e "$ftl_state_current_path\n$ftl_state_current_extension\n$ftl_state_current_mime_type"))

	[[ "$players" ]] &&
		{
		local m p
		{ IFS= read m ; IFS= read p ; } < <(echo "$players" | fzf-tmux -0 -1 -p 80% -m --expect=ctrl-t --info=inline | cut -f 2-)

		[[ "$p" ]] && { ftl::prev::clear ; [[ $m ]] && { ($p "$ftl_state_current_path" &) ; sleep 0.4 ; } || { exec 2>&9 ; ftl::util::run_maximized $p "$ftl_state_current_path" ; exec 2>"$ftl_state_session_dir/log" ; ftl::util::enter_alt_screen ; _ftl::list::print_header '' "$ftl_list_header_mode_glyphs" ; } ; }
		} ||
		{
		tmux split-window -l 50% "mimeopen - '$ftl_state_current_path'"
		}
}

