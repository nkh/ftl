#!/bin/bash

export LC_ALL=en_US.UTF-8

mkdir -p "$2"
exec 2>>"$2/generators_log"

f="$(md5sum <<<"$1" | cut -d' ' -f1)_$(basename "$1")"
f=$(perl -e '($f = $ARGV[0]) =~ s/[^a-zA-Z0-9]/_/g ; print $f' "$f")
t="$2/$f.jpg"

image='not regenerated'

[[ FORCE == "$4" || "$t" -ot "$1" ]] &&
	{
	image="$(rar lb "$1" \*.jpg \*.png | perl -ne '! /\d\D\..*$/ and print' | sort | head -n1)"
	unrar p -ierr -inull -c- "$1" "$image" > "$2/$f.large.jpg"
	vipsthumbnail --size 600x "$2/$f.large.jpg" -o "$t"
	rm "$2/$f.large.jpg" 2>&-
	}

echo "$t"
