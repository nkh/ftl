
ftl::kbd::bind	nkh	test	V	ftl::plugin::fzf_search::show_fzf_view	"fzf view"

ftl::plugin::fzf_search::show_fzf_view()
{
	local ftl_plugin_fzf_search_query=
	local ftl_plugin_fzf_search_answer ftl_plugin_fzf_search_total_count ftl_plugin_fzf_search_entries

	ftl::prev::clear

	ftl_plugin_fzf_search_query=

	ftl::pane::run_in_user_session _FZF_LISTEN \
		"FZF_DEFAULT_COMMAND='$ftl_cfg_fzf_listen_command' fzf --listen $ftl_cfg_fzf_listen_port"
	sleep .1

	ftl_plugin_fzf_search_answer="$(xh :$ftl_cfg_fzf_listen_port limit=="$((ftl_pane_height * 3))")"
	ftl_plugin_fzf_search_total_count="$(<<<"$ftl_plugin_fzf_search_answer" jq -r '.totalCount')"
	ftl_plugin_fzf_search_entries="$(<<<"$ftl_plugin_fzf_search_answer" jq -r '.matches[].text')"

	ftl_list_entry_count=$ftl_plugin_fzf_search_total_count
	ftl_state_search_string="$ftl_plugin_fzf_search_query/0"
	__ftl::list::scan_and_render ftl::plugin::fzf_search::get_custom_entries

	custom_list=1
	ftl_kbd_submode_handler=ftl::plugin::fzf_search::fzf_client
}

ftl_plugin_fzf_search_entries=()
ftl::plugin::fzf_search::fzf_client()
{
	local ftl_plugin_fzf_search_request

	ftl_plugin_fzf_search_request=

	case "$ftl_kbd_current_key" in
		ERROR_142   ) : ;;

		RIGHT       ) ;;
		LEFT        ) ;;

		+           ) preview_size ;;
		CTL-E       ) ftl_state_external_viewer_mode=2 ; ftl::prev::dispatch ;;
		CTL-V       ) preview_pane ;;
		PGDN        ) move_page_down ;;
		PGUP        ) move_page_up ;;
		DOWN        ) move_down ;;
		UP          ) move_up ;;

		,           ) selection_flip_down ;;
		';'         ) selection_flip_up ;;

		ENTER       )
			ftl_plugin_fzf_search_request=accept
			ftl_kbd_submode_handler=
			ftl_state_search_string=
			custom_list=
			[[ -d "$ftl_state_current_dir/$ftl_state_current_path" ]] && \
				ftl::list::change_dir "$ftl_state_current_dir/$ftl_state_current_path" || \
				ftl::list::change_dir "$ftl_state_current_dir" "$ftl_state_current_stem"
			;;

		DEL| ESCAPE )
			ftl_plugin_fzf_search_request=abort
			ftl_kbd_submode_handler=
			ftl_state_search_string=
			ftl_list_entry_count=
			custom_list=
			ftl::list::change_dir
			# ((ftl_cfg_fzf_listen_port++))
			;;

		BACKSPACE   )
			[[ -n "$ftl_plugin_fzf_search_query" ]] && {
				ftl_plugin_fzf_search_request=backward-delete-char
				ftl_plugin_fzf_search_query="${ftl_plugin_fzf_search_query::-1}"
			}
			;;
		BACKSLASH   ) : ;;
		LEADER      )
			ftl_plugin_fzf_search_request="put( )"
			ftl_plugin_fzf_search_query="$ftl_plugin_fzf_search_query "
			;;
		QUOTE       )
			ftl_plugin_fzf_search_request="put(')"
			ftl_plugin_fzf_search_query="$ftl_plugin_fzf_search_query'"
			;;
		*           )
			ftl_plugin_fzf_search_request="put($ftl_kbd_current_key)"
			ftl_plugin_fzf_search_query="$ftl_plugin_fzf_search_query$ftl_kbd_current_key"
			;;
	esac

	[[ -n "$ftl_plugin_fzf_search_request" ]] && {
		xh :$ftl_cfg_fzf_listen_port --raw "$ftl_plugin_fzf_search_request" >/dev/null

		[[ "$ftl_plugin_fzf_search_request" == abort || "$ftl_plugin_fzf_search_request" == accept ]] || {
			# ftl_plugin_fzf_search_answer="$(xh :$ftl_cfg_fzf_listen_port limit=="$((ftl_pane_height - 1))")"
			ftl_plugin_fzf_search_answer="$(xh :$ftl_cfg_fzf_listen_port limit=="$((3 * ftl_pane_height))")"
			ftl_plugin_fzf_search_total_count="$(<<<"$ftl_plugin_fzf_search_answer" jq -r '.totalCount')"
			fzf_match_count="$(<<<"$ftl_plugin_fzf_search_answer" jq -r '.matchCount')"
			ftl_plugin_fzf_search_entries="$(<<<"$ftl_plugin_fzf_search_answer" jq -r '.matches[].text')"

			ftl_list_entry_count=$ftl_plugin_fzf_search_total_count
			ftl_state_search_string="$ftl_plugin_fzf_search_query/${fzf_match_count:-?}"

			__ftl::list::scan_and_render ftl::plugin::fzf_search::get_custom_entries
		}
	}
}

ftl::plugin::fzf_search::get_custom_entries()
{
	local dst dst_path dst_file relative_path entry colored_entry entry_index

	dir_entries_list=()
	dir_entries_file=()
	dir_entries_path=()
	dir_entries_relative_path_length=()
	dir_entries_size=()
	dir_entries_color=()

	lscolors_args=()

	[[ -z "$ftl_plugin_fzf_search_entries" ]] && return

	while read dst ; do
		[[ "$dst" =~ / ]] && dst_path="${dst%/*}" || dst_path=
		[[ ${dst_path:0:1} != "/" ]] && dst_path="$PWD/$dst_path"
		dst_file="${dst##*/}"

		dir_entries_list+=("$dst")
		dir_entries_file[$dst]="$dst_file"
		dir_entries_path[$dst]="$dst_path"

		[[ $PWD/ == "$dst_path" ]] && dir_entries_relative_path_length[$dst]=0 || {
			relative_path="${dst_path:((${#PWD}+1))}/"
			dir_entries_relative_path_length[$dst]=${#relative_path}
		}
	done <<<"$ftl_plugin_fzf_search_entries"

	for entry in "${dir_entries_list[@]}" ; do
		[[ $PWD/ == ${dir_entries_path[$entry]} ]] && \
			lscolors_args+=("${dir_entries_file[$entry]}") || \
			lscolors_args+=("${dir_entries_path[$entry]:((${#PWD}+1))}/${dir_entries_file[$entry]}")

		dir_entries_size[$entry]=10
	done

	entry_index=0
	while read colored_entry ; do
		dir_entries_color[${dir_entries_list[$entry_index]}]="$colored_entry"
		((entry_index++))
	done < <(lscolors "${lscolors_args[@]}")
}

