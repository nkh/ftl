
# these commands let you copy or move the selection another *tab*'s directory
# this is more practical than an orthodox 2 panes view because there's IMO
# little interest to see the other view updated, all we need is the files
# to be moved or copied

# if there is just one tab, a new tab is created
#
# if there are just two tabs, copy/move to the other tab
#       this lets you quickly select in a tab and send to another one
#
# if there are more than two tabs, you can chose which directory in fzf
#       if you don't chose a directory, a new one is created
#               the logic is that you want to copy/move but you don't have
#               a destination
#
#               if you wanted to quit in the middle of the copy/move, after
#               the new tab  is created, close it.

# configuration variable in these commands
ftl_cfg_default_new_tab_dir=  # in default new tab location if no other tab exists

# function you can ftl::kbd::bind
ftl::plugin::to_other_tab::tag_copy_to_tab()
{
	ftl::sel::validate_existence && {
		other_dir="$(ftl::plugin::to_other_tab::other_tab_dir)" && {
			cp_mv_tags copy "$other_dir"
			ftl::list::change_dir '' "$ftl_state_current_basename"
		} || ftl_cfg_default_new_tab_dir
	}
}

ftl::plugin::to_other_tab::tag_move_to_tab()
{
	ftl::sel::validate_existence && {
		other_dir="$(ftl::plugin::to_other_tab::other_tab_dir)" && {
			cp_mv_tags move "$other_dir"
			ftl::list::change_dir '' "$ftl_state_current_basename"
		} || ftl_cfg_default_new_tab_dir
	}
}

# support functions
ftl_cfg_default_new_tab_dir()
{
	ftl::log::warn "copy/move to tab:\n\tcreating new tab"
	ftl::tab::create "${ftl_cfg_default_new_tab_dir:-$HOME}"
}

ftl::plugin::to_other_tab::other_tab_dir()
{
	if (( ftl_tab_count > 2 )) ; then
		ftl::plugin::to_other_tab::pick_tab_dir
		return $?
	else
		ftl::plugin::to_other_tab::pick_other_tab_dir
	fi
}

ftl::plugin::to_other_tab::pick_tab_dir()
{
	local ptd
	ptd="$(printf "%s\n" "${ftl_tab_directories[@]}" | sort -u | lscolors | fzf-tmux $ftl_cfg_fzf_popup_opts --tac --ansi)" && \
		echo "$ptd"
}

ftl::plugin::to_other_tab::pick_other_tab_dir()
{
	local ctab other_tab
	ctab=$ftl_state_current_tab_index
	ftl::tab::advance_index
	other_tab=$ftl_state_current_tab_index
	ftl_state_current_tab_index=$ctab
	[[ $other_tab != $ftl_state_current_tab_index ]] && echo "${ftl_tab_directories[$other_tab]}"
}

