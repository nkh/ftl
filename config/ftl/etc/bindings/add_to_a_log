leader_add_to_a_log()
{
    echo "$ftl_state_current_basename" >> a_log
}
ftl::kbd::ftl::kbd::bind leader add_to_a_log        "LEADER a a"            leader_add_to_a_log             "add filename to a_log"

leader_a_edit_leader_a_log()
{
    ftl::prev::clear
    $ftl_cfg_editor "a_log"
    ftl::ftl::list::render::render
}
ftl::kbd::ftl::kbd::bind leader add_to_a_log        "LEADER a v"            leader_a_edit_leader_a_log      "edit a_log"

leader_a_add_to_log_and_edit()
{
    echo "$ftl_state_current_basename" >> a_log
    ftl::prev::clear
    $ftl_cfg_editor "a_log"
    ftl::ftl::list::render::render
}
ftl::kbd::ftl::kbd::bind leader add_to_a_log        "LEADER a e"            leader_a_add_to_log_and_edit    "add filename to a_log and edit"
