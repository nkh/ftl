. "$FTL_CFG/etc/bindings/lib/compress"
. "$FTL_CFG/etc/bindings/lib/optimize"
. "$FTL_CFG/etc/bindings/lib/extra"

ftl::kbd::bind  leader_ftl      extra   "LEADER f c"    ftl::plugin::file_utils::compress       "ftl::plugin::file_utils::compress in tar.bz2"
ftl::kbd::bind  leader_ftl      extra   "LEADER f d"    ftl::plugin::file_utils::decompress     "ftl::plugin::file_utils::decompress"
ftl::kbd::bind  leader_ftl      extra   "LEADER f D"    ftl::plugin::file_utils::decompress_in_dir      "ftl::plugin::file_utils::decompress directory"
ftl::kbd::bind  leader_ftl      extra   "LEADER f e"    ftl::plugin::file_utils::gpg_encrypt    "GPG encrypt/decrypt"
ftl::kbd::bind  leader_ftl      extra   "LEADER f E"    ftl::plugin::file_utils::pass_encrypt   "password encrypt/decrypt"
ftl::kbd::bind  leader_ftl      extra   "LEADER f g"    ftl::plugin::file_utils::stat_file      "display stat information in ftl::prev::dispatch pane"
ftl::kbd::bind  leader_ftl      extra   "LEADER f h"    ftl_help        "display help"
ftl::kbd::bind  leader_ftl      extra   "LEADER f i"    ftl::plugin::file_utils::image_optimize "reduce jpg image size, converts png to jpg"
ftl::kbd::bind  leader_ftl      extra   "LEADER f l"    ftl::plugin::file_utils::lint   "run rmlint in current_directory"
ftl::kbd::bind  leader_ftl      extra   "LEADER f m"    ftl::plugin::file_utils::run_mutt       "send selection in mail"
ftl::kbd::bind  leader_ftl      extra   "LEADER f P"    ftl::plugin::file_utils::pdf2txt        "convert current pdf to text file"
ftl::kbd::bind  leader_ftl      extra   "LEADER f p"    ftl::plugin::file_utils::pdf_optimize   "reduce pdf size"
ftl::kbd::bind  leader_ftl      extra   "LEADER s"      ftl::plugin::file_utils::shell_popup    "terminal popup"
ftl::kbd::bind  leader_ftl      extra   "LEADER f v"    ftl::plugin::file_utils::video_optimize "reduce video size"

