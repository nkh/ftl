. "$FTL_CFG/etc/bindings/lib/compress"
. "$FTL_CFG/etc/bindings/lib/optimize"
. "$FTL_CFG/etc/bindings/lib/extra"

ftl::kbd::ftl::kbd::bind leader_ftl extra   "LEADER f c"    compress                "compress in tar.bz2"
ftl::kbd::ftl::kbd::bind leader_ftl extra   "LEADER f d"    decompress              "decompress"
ftl::kbd::ftl::kbd::bind leader_ftl extra   "LEADER f D"    decompress_in_dir       "decompress directory"
ftl::kbd::ftl::kbd::bind leader_ftl extra   "LEADER f e"    gpg_encrypt             "GPG encrypt/decrypt"
ftl::kbd::ftl::kbd::bind leader_ftl extra   "LEADER f E"    pass_encrypt            "password encrypt/decrypt"
