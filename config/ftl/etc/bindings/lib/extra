

restic_snapshots()
{
[[ $RESTIC_REPOSITORY ]] || { tmux popup -h 10% -w 50% -E -d "$PWD" "echo 'restic repository not set, aborting' ; read -sn1" ; return ; }
tmux popup -h 90% -w 90% -E -d "$PWD" "restic -r $RESTIC_REPOSITORY snapshots ; read -sn1"
}

restic_backup()
{
[[ $RESTIC_REPOSITORY ]] || { tmux popup -h 10% -w 50% -E -d "$PWD" "echo 'restic repository not set, aborting' ; read -sn1" ; return ; }

# Prompt 'restic backup: ' -e && [[ -n "$REPLY" ]] && RESTIC_REPOSITORY="$REPLY" || \
# 	{ echo "restic repository not set, aborting" ; read -sn1 ; return 1 ; }

cmd="restic -r $RESTIC_REPOSITORY backup --verbose $(printf '%q ' "${selection[@]}") ; echo 'backup done, press any key'; read -sn1"

tmux popup -h 90% -w 90% -E -d "$PWD" "$cmd"
}

# ffmpeg_to_mp3() { tmux popup -h 90% -w 90% -E -d "$PWD" "/usr/bin/ffmpeg -i '$f' -q:a 2 '$f.mp3'" ; cdir '' "$f3" ; }
ffmpeg_to_mp3()
{
tmux popup -h 90% -w 90% -E -d "$PWD" \
	"for f in $(printf '%q ' "${selection[@]}"); do
		/usr/bin/ffmpeg -i \"\$f\" -q:a 2 \"\$f.mp3\"
		done

	echo conversion done, press any key ; read -sn1"

cdir '' "$f3"
}

pdf2txt()     { [[ $e == pdf ]] && [[ ! -e "$f.txt" ]] && { mutool draw -o "$f.txt" "$f" 2>/dev/null ; cdir '' "$f.txt" ; } ; }
lint()        { rmlint "$PWD" ; cdir '' 'rmlint' ; }
run_mutt()    { mutt $([[ ${#selection[@]} ]] && printf "\055a %s\n" "${selection[@]}" || [[ $f ]] && echo "-a $f") -s 'ftl files' -- ; refresh ; list ; }
shell_popup() { tmux popup -E -d "$PWD" -w 80%  -h 80% ; }

stat_file()
{
tcpreview ; mime_get 

tsplit "{ echo -n '  File: ' ; echo ${n@Q} | lscolors ; hsize=\$(echo -n 'H_size: ' ; stat -c %s '$n' | numfmt --to=iec) ; stat '$n' | sed -e '/File:/d' -e \"s/Device:/\$hsize            Device:/\" -e 's/IO Block/IO_Block/' ; echo '  mime: $mtype' ; echo -n '  type: ' ; file -b ${n@Q} ; } | piper --global '[A-Za-z-_]+: ' 'blue' '\d+\ ?x\ ?\d+' 'yellow' ; read -sn 1"
}

gpg_encrypt()
{
exec 2>&9

[[ $e =~ gpg ]] && tmux popup -h90% -w90% "gpg -d $n" ||
	gpg -e -u "$GPGID" -r "$(gpg -K | grep uid | cut -d' ' -f 13- | fzf)" "$f" ||
	error failed GPG encryption

exec 2>"$fs/log"
alt_screen

cdir '' "$f.gpg"
}

pass_encrypt()
{
[[ $e =~ gpg ]] && \
	prompt 'file: ' -e && [[ -n "$REPLY" ]] && gpg -d --no-symkey-cache "$n" > "$REPLY" || \
	{ gpg --no-symkey-cache --symmetric "$f" || read -sn1 ; }
cdir '' "$REPLY"
}

free_space() { tmux popup -h 25% -w 50% -E -d "$PWD" "df ; read -sn1" ; }

