#----------------------------------------------------------------------------
# Debug bindings (toggleable logging)
#----------------------------------------------------------------------------

ftl::cmd::toggle_debug() {
        if (( ftl_log_level == 0 )) ; then
                ftl::log::set_level 1
                ftl::log::info "debug logging enabled"
                tmux popup -w 40% -h 5 "echo -ne '\e[33mDebug logging ON\e[m'"
        else
                ftl::log::set_level 0
                tmux popup -w 40% -h 5 "echo -ne '\e[33mDebug logging OFF\e[m'"
        fi
}

ftl::cmd::toggle_trace() {
        if (( ftl_log_level < 2 )) ; then
                ftl::log::set_level 2
                ftl::log::info "trace logging enabled"
                tmux popup -w 40% -h 5 "echo -ne '\e[33mTrace logging ON\e[m'"
        else
                ftl::log::set_level 0
                tmux popup -w 40% -h 5 "echo -ne '\e[33mTrace logging OFF\e[m'"
        fi
}

ftl::kbd::bind  ftl     ftl     "LEADER d d"    ftl::cmd::toggle_debug  "toggle debug logging"
ftl::kbd::bind  ftl     ftl     "LEADER d t"    ftl::cmd::toggle_trace  "toggle trace logging"

#----------------------------------------------------------------------------
# Auto-source binding plugins
#----------------------------------------------------------------------------

# Source all binding plugins from etc/bindings/ and bindings/.
# Uses fd if available, falls back to find (which is always installed).
if command -v fd >/dev/null 2>&1 ; then
        _ftl_list_bindings() { fd . "$1" --type f | sort -u ; }
else
        _ftl_list_bindings() { find "$1" -type f | sort -u ; }
fi

for b in $(_ftl_list_bindings "$FTL_CFG/etc/bindings") ; do source "$b" ; done
for b in $(_ftl_list_bindings "$FTL_CFG/bindings" 2>/dev/null) ; do source "$b" ; done
unset -f _ftl_list_bindings

