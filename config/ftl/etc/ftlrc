# ftlrc — ftl configuration file
#
# This file is sourced at startup by ftl_setup. It sets configuration
# variables (all prefixed with ftl_cfg_) and registers keyboard bindings
# (via ftl::kbd::bind).
#
# Users can override any of these by creating their own ~/.config/ftl/ftlrc
# that sources this default and then changes values.

FTL_BOOTSTRAP_DONE=1
LANG=C
LC_ALL=C

#----------------------------------------------------------------------------
# Directory layout
#----------------------------------------------------------------------------

# Location of preview generator scripts
ftl_gen_dir="$FTL_CFG/etc/generators"

# Runtime state directory (per-session state, history, marks, thumbnails)
ftl_state_dir="$FTL_CFG/var"
export ftl_state_dir
mkdir -p "$ftl_state_dir"

# State sub-paths
FTL_STATE_DIR="$ftl_state_dir"
FTL_CACHE_DIR="$ftl_state_dir/thumbs"
export FTL_STATE_DIR FTL_CACHE_DIR

# Global directory-visit history (across all sessions)
ftl_state_global_history_file="$ftl_state_dir/history"
touch "$ftl_state_global_history_file"

# Thumbnail cache directory
ftl_cache_thumb_dir="$ftl_state_dir/thumbs"
mkdir -p "$ftl_cache_thumb_dir"

# Command to run when the user presses ? for help
ftl_cfg_help_command="man ftl.1"

#----------------------------------------------------------------------------
# Bookmarks and destinations
#----------------------------------------------------------------------------

# Session marks (single-char bookmarks). Keys are characters, values are
# paths ending in $ for directories or no suffix for files.
declare -Ag ftl_mark_session_marks=(
        [0]=/
        [1]="$HOME/"
        [2]=/CHANGE_ME/dir/filename
        [3]=/CHANGE_ME/dir/filename
        ["'"]="$(tail -n1 "$ftl_state_global_history_file")"
)

# Preset destinations for copy/move (PP / PM bindings)
declare -Ag ftl_cfg_preset_destinations=()

# Color overrides (overrides LS_COLORS for specific filenames)
# declare -Ag ftl_cfg_color_overrides=([?]="30;42")

#----------------------------------------------------------------------------
# Behavior options
#----------------------------------------------------------------------------

# Seconds for key read timeout (controls reactivity of time events)
ftl_cfg_key_timeout=1

# Shell pane dimensions (tmux size specs)
ftl_cfg_shell_pane_height=40%
ftl_cfg_shell_pane_width=60%

# Automatically synchronize selection between panes
ftl_cfg_auto_sync_selection=1

# Interval in seconds for time events (0 = disabled)
ftl_cfg_time_event_interval=0

# If set, debug messages are also logged to this file
ftl_cfg_debug_log_file=

# Default directory preview mode (0=ftl, 1=du, 2=ls, 3=README, 4=exa, 5=image)
ftl_state_dir_preview_mode=0

# Default alternative preview mode (0=default, 1-5=alternatives)
ftl_state_alt_preview_mode=0

# Whether the preview pane is visible by default
: ${ftl_state_preview_pane_visible:=1}

# Available preview pane sizes (percentages) and starting index
ftl_cfg_preview_zoom_levels=(85 70 50 30)
ftl_state_preview_zoom_index=1

# Number of entries to move with step commands
ftl_cfg_move_step_size=4

# Status messages for long operations
ftl_cfg_msg_montage='Creating montage ...'
ftl_cfg_msg_du_size='Computing dir sizes ...'

# File to auto-select when entering a new directory
ftl_cfg_auto_select_filename=README

# ANSI colors for the entry-index column
ftl_cfg_line_color_default="\e[2;40;90m"
ftl_cfg_line_color_current="\e[2;40;90m"
ftl_cfg_line_color_highlight="\e[38;5;240m"

# Whether to mount archives via fuse-archive
ftl_cfg_mount_archives=0

# ANSI colors for the cursor (the tag glyph of the current entry)
ftl_cfg_cursor_color_default='\e[7;34m'
ftl_cfg_cursor_color_current='\e[7;34m'
ftl_cfg_cursor_color_search='\e[7;35m'

# Whether to show help and bindings in popups
ftl_cfg_help_in_popup=0
ftl_cfg_bindings_in_popup=1

# Threshold for quick-display mode (flash count during scanning)
ftl_cfg_quick_display_threshold=512

# Default reverse filter (applied to every new tab)
ftl_cfg_default_reverse_filter=

# Display toggles
ftl_cfg_show_entry_index=1
ftl_state_show_size_mode=0
ftl_cfg_show_date_in_header=1
ftl_cfg_show_tar_info=0

# Default new-tab location for copy/move-to-tab
ftl_cfg_default_new_tab_dir=

# Tmux border colors (restored on quit)
ftl_cfg_tmux_border_colors_default='236 52'
ftl::pane::set_border_colors 67 67

#----------------------------------------------------------------------------
# External tags (etags)
#----------------------------------------------------------------------------

ftl_state_etag_enabled=0
# To enable git etags by default, uncomment:
# source "$FTL_CFG/etc/etags/git"
# ftl_state_etag_enabled=1

#----------------------------------------------------------------------------
# Sort defaults
#----------------------------------------------------------------------------

ftl_cfg_default_sort_type=0        # 0=alphanumeric, 1=size, 2=date
ftl_cfg_default_sort_reversed=

# Sort options for each sort type (passed to `sort` command)
# 0=alphanumeric (sort by name), 1=size (sort by size), 2=date (sort by date)
ftl_cfg_sort_options=('-k3 -V' '-n' '-k2 -V')

#----------------------------------------------------------------------------
# Glyph tables
#----------------------------------------------------------------------------

ftl_cfg_glyph_sort=(⍺ 🡕)                    # 0=alphanumeric, 1=size
ftl_cfg_glyph_image_mode=('' ᴵ ᴺ)           # 0=all, 1=no-image, 2=image
ftl_cfg_glyph_listing_mode=('' ᵈ ᶠ)         # 0=all, 1=dir-only, 2=file-only
ftl_cfg_glyph_tag_classes=('' ¹ ² ³ D)      # 0=unused, 1-4=classes

#----------------------------------------------------------------------------
# Media filter regexes
#----------------------------------------------------------------------------

ftl_cfg_image_extensions_regex='svg|webp|jpg|jpeg|JPG|png|gif|bmp'
ftl_cfg_media_extensions_regex='mp3|mp4|flv|mkv|webm'
ftl_state_pdf_preview_as_image=0

#----------------------------------------------------------------------------
# FZF options
#----------------------------------------------------------------------------

ftl_cfg_fzf_popup_opts="-p 90% --cycle --reverse --info=inline --color=hl+:214,hl:214"
ftl_cfg_fzf_pane_opts="--cycle --expect=ctrl-t --reverse"
ftl_cfg_fzf_sxiv_opts="-0 -1 -m --expect=ctrl-t --bind alt-a:select-all"
ftl_cfg_fzf_listen_port=4466
ftl_cfg_fzf_listen_command='fd -H -I'

#----------------------------------------------------------------------------
# External commands
#----------------------------------------------------------------------------

ftl_cfg_image_viewer=sxiv
ftl_cfg_gif_viewer=                        # https://github.com/tomas/pixelhopper
ftl_cfg_editor="vim -p"
ftl_cfg_diff_tool=vimdiff

# Image preview daemon hints
ftl_cfg_image_clean_borders=1              # set to 0 if using konsole
ftl_cfg_char_height_px=21
ftl_cfg_char_width_px=10
ftl_cfg_image_zoomed=0

ftl_cfg_gpg_key_id=CHANGE.ME

# Media players
ftl_cfg_gui_media_player="vlc -f"
ftl_cfg_terminal_media_player="mplayer -vo null"
ftl_cfg_external_terminal_player="vlc -I curses"
ftl_cfg_live_preview_player='mplayer -msglevel all=-1 -msglevel statusline=6 -nolirc -msgcolor -novideo -vo null'
ftl_cfg_background_player="$FTL_CFG/etc/viewers/mplayer_local"
ftl_cfg_queue_player="$FTL_CFG/etc/viewers/cmus"

# Pagers
ftl_cfg_ansi_pager='/usr/bin/less -R'
ftl_cfg_markdown_pager='/usr/bin/less -R'

# Markdown renderers
ftl_cfg_markdown_renderer_default='ftl::plugin::core::ptext'
ftl_cfg_markdown_renderer_1='vmd'
ftl_cfg_markdown_renderer_2='vmd'
ftl_cfg_markdown_dir_renderer="vmd"

# Hex tools
ftl_cfg_hex_viewer=hexdump
ftl_cfg_hex_editor=hexedit

# File type detection
ftl_cfg_mime_detector=mimemagic

# Disk usage tool
ftl_cfg_disk_usage_tool=ncdu

# JSON/YAML viewers
ftl_cfg_json_viewer=jless
ftl_cfg_yaml_viewer="yam -i"

# exa (directory preview)
ftl_cfg_exa_colors="ur=1;34:uw=1;34:ux=1;34:gr=1;34:gw=1;34:gx=1;34:tr=1;34:tw=1;34:tx=1;34:sn=1;30:sb=1;30:uu=1;30:da=1;30:hd=1;30"
ftl_cfg_exa_options="-l --tree -L 3 --header --color=always"

# Deletion command
ftl_cfg_delete_command="rm -rf"

#----------------------------------------------------------------------------
# Inline rename mode (LEADER r i) — see documentation/ftl-inline-rename-proposal.md
#----------------------------------------------------------------------------

# Whether 'd' in inline-rename mode deletes without confirmation
ftl_cfg_inline_rename_no_confirm_delete=0

# Format string for sequential rename. printf-style; %03d = zero-padded 3-digit
ftl_cfg_inline_rename_sequence_format='%03d'

# Default sed expression pre-filled in the regexp-rename prompt
ftl_cfg_inline_rename_regexp_default='s/OLD/NEW/'

# File extensions considered images (for the 'l' label sub-mode)
ftl_cfg_image_extensions=(jpg jpeg png gif tiff tif bmp webp heic)

# Glyphs shown in the header while inline-rename mode is active
ftl_cfg_glyph_inline_rename='⟦R⟧'
ftl_cfg_glyph_inline_rename_edit='⟦R✎⟧'

# Using rm-improved (rip) instead:
# ftl_cfg_delete_command="rip --graveyard '$HOME/graveyard'"
# mkdir -p "$HOME/graveyard"
# ftl::kbd::bind        ftl     entry   U       unbury  "undo last deletion"
# unbury() { last_bury="$(rip --graveyard "$HOME/graveyard" -s | tail -n1)" ; [[ -n "$last_bury" ]] && { rip --graveyard "$HOME/graveyard" -u ; ftl::list::change_dir "$PWD" "$(basename "$last_bury")" ; } ; }

# Using FreeDesktop.org Trash:
# ftl_cfg_delete_command="trash-put"

# Display width for the bindings table
ftl_cfg_bindings_display_width=150

# Command aliases for the command prompt
declare -Ag ftl_cfg_command_aliases=(
        [csx]="split finfo | xargs -0"
        [cfx]="full finfo | xargs -0"
)

