etag_name() { echo tmsu ; }

tmsu_etag_dir()
{
declare -g -A tmsu_untags=() ;
readarray -t files < <(unbuffer tmsu untagged | grep -v '/.*/' | sed 's/^.\///')
for file in "${files[@]}" ; do tmsu_untags[$file]="  " ; done
}

#ᵀ⁝
tmsu_etag_tag() { local -n r2=$2 r3=$3 ; r2= ; r3=0 ; r2="${tmsu_untags[$1]:-ᵀ }" ; r3=2 ; }

