ftl::etag::scan_directory()
{
	declare -g -A ext_lines=()

	local ext_file_lines ext_file

	while read ext_file_lines ext_file ; do
		ext_lines[$ext_file]="$(printf "\e[2;37m%5s \e[m" "$ext_file_lines")"
	done < <(find "$PWD/" -mindepth 1 -maxdepth 1 -type f,l -printf '%P\n' | xargs grep -I -H -l . 2>&- | xargs wc -l)
}

ftl::etag::get_entry_tag()
{
	local -n r2=$2 r3=$3
	r2=
	r3=0
	r2="${ext_lines[$1]}"
	[[ "$r2" ]] || r2='      '
	r3=6
}

