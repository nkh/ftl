yellow=$'\e[93m'
reset=$'\e[0m'

etag_name() { echo git ; }

git_etag_dir()
{
declare -g -A git_tags=() ; is_git=0

git rev-parse HEAD &>/dev/null && 
	{
	readarray -t lines < <(unbuffer git status -s * 2>/dev/null)
	is_git=1
	
	for line in "${lines[@]}"
		do 
			git_status=
			
			if [[ ${line:0:2} == "  " ]]; then
				# two leading spaces → one plain space cell
				git_status+=" "
				line=${line:1}
			else
				# optional leading space before ANSI
				if [[ ${line:0:1} == " " ]]; then
					git_status+=" "
					line=${line:1}
					fi
				
				# ANSI-colored character cell (line now starts with CSI)
				tmp=${line#*$'m'}      # remove opening CSI sequence
				ch=${tmp:0:1}          # visible character
				tmp=${tmp:1}
				end=${tmp%%m*}         # until terminating 'm'
				len=$(( ${#line} - ${#tmp} + ${#end} + 1 ))
				
				git_status+=${line:0:len}
				line=${line:len}
			fi
			
			file=${line# }
			file=${file#\"}
			file=${file%\"}
			
			case $file in
				# directory
				*/*) file="${file%%/*}" ; git_status="$yellow**$reset" ;;
			esac
			
			pdhn "<${line}> -> <${file}> <${git_status}>"
			git_tags[$file]="${git_status} "
		done
	}
}

git_etag_tag() { local -n r2=$2 r3=$3 ; r2= ; r3=0 ; (( is_git )) && { r2="${git_tags[$1]:-   }" ; r3=3 ; } ; }

