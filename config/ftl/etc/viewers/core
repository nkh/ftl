# ftl::prev::dispatch and external viewer for ftl

source "$FTL_CFG/etc/commands/open_with"

ftl::plugin::core::user_eviewers() { false ; }
ftl::plugin::core::user_pviewers() { false ; }

ftl::plugin::core::ext_viewers()
{
        ftl::plugin::core::user_eviewers && return ;

        [[ -d "$ftl_state_current_path"               ]] && { ftl::plugin::core::ext_dir   ; return ; }
        [[ $ftl_state_current_extension =~ html       ]] && { ftl::plugin::core::ext_html  ; return ; }
        [[ $ftl_state_current_extension =~ svg        ]] && { ftl::plugin::core::ext_svg   ; return ; }
        [[ $ftl_state_current_extension =~ $ftl_cfg_image_extensions_regex ]] && { ftl::plugin::core::ext_image ; return ; }
        [[ $ftl_state_current_extension == mp3        ]] && { ftl::plugin::core::ext_mp3   ; return ; }
        [[ $ftl_state_current_extension =~ $ftl_cfg_media_extensions_regex ]] && { ftl::plugin::core::ext_media ; return ; }
        [[ $ftl_state_current_extension == pdf || $ftl_state_current_extension == PDF ]] && { ftl::plugin::core::ext_pdf   ; return ; }
        [[ $ftl_state_current_extension == sc         ]] && { ftl::plugin::core::ext_scim  ; return ; }
        [[ $ftl_state_current_extension =~ ^md|MD$    ]] && { ftl::plugin::core::pmd       ; return ; }
        [[ $ftl_state_current_extension == epub       ]] && { ftl::plugin::core::ext_epub  ; return ; }
        [[ $ftl_state_current_extension =~ ^json|yml$ ]] && [[ -s "$ftl_state_current_path" ]] && { ftl::plugin::core::ext_json ; return ; }

        ((ftl_state_external_viewer_mode == 3)) && { ftl::plugin::core::open_with ; return ; }

        ftl::list::get_mime_type

        [[ $ftl_state_current_mime_type =~ ^text ]] && [[ -s "$ftl_state_current_path" ]] && { ftl::plugin::core::ext_text ; return ; }

        ftl::plugin::core::open_with
}

ftl::plugin::core::pviewers()
{
        ((${#ftl_plugin_vfiles[@]} || ${#ftl_plugin_vdirs[@]})) && { ftl::plugin::virtual::preview_callback && return ; }

        ftl::plugin::core::user_pviewers && return ;

        [[ -d "$ftl_state_current_path"               ]] && { ftl::plugin::core::pdir      ; return ; }

        [[ $ftl_state_current_extension               ]] && ((ftl_view_preview_ignore_exts["${ftl_state_current_basename@Q}"])) && { ftl_preview_is_dir_ftl= ; ftl::plugin::core::ptype ; return ; }
        [[ -e "$ftl_state_session_dir/lock_preview/$ftl_state_current_path" ]] && { ftl::plugin::core::plock     ; return ; }
        [[ "${ftl_tab_preview_dirs_only[ftl_state_current_tab_index]}" ]] && { [[ -d "$ftl_state_current_path" ]] || { ftl::prev::clear ; return ; } ; }

        [[ $ftl_state_current_extension == cbr        ]] && { ftl::plugin::core::pcbr      ; return ; }
        [[ $ftl_state_current_extension == cbz        ]] && { ftl::plugin::core::pcbz      ; return ; }
        [[ $ftl_state_current_extension == html       ]] && { ftl::plugin::core::phtml     ; return ; }
        [[ $ftl_state_current_extension == svg        ]] && { ftl::plugin::core::psvg      ; return ; }
        [[ $ftl_state_current_extension == gif        ]] && { ftl::plugin::core::pgif      ; return ; }
        [[ $ftl_state_current_extension =~ $ftl_cfg_image_extensions_regex ]] && { ftl::plugin::core::pimage    ; return ; }
        [[ $ftl_state_current_extension == mp3        ]] && { ftl::plugin::core::pmp3      ; return ; }
        [[ $ftl_state_current_extension =~ $ftl_cfg_media_extensions_regex ]] && { ftl::plugin::core::pmedia    ; return ; }
        [[ $ftl_state_current_extension =~ ^md|MD$    ]] && { ftl::plugin::core::pmd       ; return ; }
        [[ $ftl_state_current_extension == pdf || $ftl_state_current_extension == PDF ]] && { ftl::plugin::core::ppdf      ; return ; }
        [[ $ftl_state_current_extension == epub       ]] && { ftl::plugin::core::pepub     ; return ; }
        [[ $ftl_state_current_extension == 1          ]] && { ftl::plugin::core::pman      ; return ; }
        [[ $ftl_state_current_extension == zip        ]] && ((ftl_state_alt_preview_mode)) && { ftl::plugin::core::pcomp     ; return ; }
        [[ $ftl_state_current_extension == rar        ]] && ((ftl_state_alt_preview_mode)) && { ftl::plugin::core::pcomp     ; return ; }
        [[ $ftl_state_current_basename =~ \.tar$      ]] && ((ftl_state_alt_preview_mode)) && { ftl::plugin::core::pcomp     ; return ; }
        [[ $ftl_state_current_basename =~ \.tar\.gz$  ]] && ((ftl_state_alt_preview_mode)) && { ftl::plugin::core::pcomp     ; return ; }
        [[ $ftl_state_current_basename =~ \.tar\.bz2$ ]] && ((ftl_state_alt_preview_mode)) && { ftl::plugin::core::pcomp     ; return ; }
        [[ -p "$ftl_state_current_path"               ]] && { ftl::plugin::core::ppipe     ; return ; }
        [[ $ftl_state_current_extension =~ json       ]] && { ftl::plugin::core::pjson     ; return ; }
        [[ $ftl_state_current_extension =~ yml        ]] && { ftl::plugin::core::pyaml     ; return ; }
        [[ $ftl_state_current_extension == sc         ]] && { ftl::plugin::core::pscim     ; return ; }
        [[ $ftl_state_current_extension =~ ^stl$      ]] && { ftl::plugin::core::pstl      ; return ; }
        [[ $ftl_state_current_extension =~ ^asciio$   ]] && { ftl::plugin::core::pasciio   ; return ; }

        ftl::list::get_mime_type
        ftl::util::is_binary_file "$ftl_state_current_path"
        ftl_state_current_file_description="$(file -b "$ftl_state_current_path")"

        [[ $ftl_state_current_mime_type =~ ^application/x-perl$ ]] && { ftl::plugin::core::ptext  ; return ; }

        [[ -s "$ftl_state_current_path" ]] && [[ "$ftl_state_current_file_description" =~ "escape sequence" ]] && { ftl::plugin::core::pansi ; return ; }

        # application/x-perl
        # Perl script text executable
        ((! ftl_state_current_is_binary)) && [[ -s "$ftl_state_current_path" ]] && \
                [[ "$ftl_state_current_file_description" =~ Unicode|ASCII || $ftl_state_current_mime_type =~ ^text ]] && { ftl::plugin::core::ptext && return ; }

        ftl::plugin::core::ptype
}

ftl::plugin::core::ext_dir()   { $ftl_cfg_gui_media_player "$ftl_state_current_path" &>/dev/null & }

ftl::plugin::core::ext_html()
{
        if ((ftl_state_external_viewer_mode == 1)) ; then
                ftl::prev::clear
                w3m -o confirm_qq=0 "$ftl_state_current_path"
        else
                (qutebrowser "$ftl_state_current_path" 2>&- &)
        fi
}

ftl::plugin::core::ext_svg()
{
        ftl::util::run_maximized mupdf "$("$ftl_gen_dir/svg_to_pdf" "$ftl_state_current_path" "$ftl_cache_thumb_dir/svg")"
}

ftl::plugin::core::ext_image()
{
        ((ftl_state_external_viewer_mode == 1)) && ftl::plugin::core::ext_iall || ftl::plugin::core::ext_ipng
}

ftl::plugin::core::ext_iall()
{
        local images=() img
        for img in "${ftl_list_entries[@]}" ; do
                [[ "$img" =~ $ftl_cfg_image_extensions_regex ]] && images+=("$img")
        done
        $ftl_cfg_image_viewer -b -q -o -f "$ftl_state_current_path" "${images[@]}"
}

ftl::plugin::core::ext_ipng()
{
        ftl::prev::clear
        ftl::util::run_maximized $ftl_cfg_gif_viewer "$ftl_state_current_path" &>/dev/null
        ftl_state_external_viewer_mode=
        ftl_kbd_current_key=
        ftl::list::render
}

ftl::plugin::core::ext_mp3()
{
        if ((ftl_state_external_viewer_mode == 1)) ; then
                ftl::cmd::kill_media_player
                ftl::prev::clear
                $ftl_cfg_external_terminal_player "${ftl_selection_current[@]}"
                true
        else
                ($ftl_cfg_gui_media_player "${ftl_selection_current[@]}" &>/dev/null &)
        fi
        ftl_view_media_pid=$!
}

ftl::plugin::core::ext_media()
{
        if ((ftl_state_external_viewer_mode == 1)) ; then
                ftl::cmd::kill_media_player
                $ftl_cfg_terminal_media_player "$ftl_state_current_path" </dev/null &>/dev/null &
        else
                ($ftl_cfg_gui_media_player "${ftl_selection_current[@]}" &>/dev/null &)
        fi
        ftl_view_media_pid=$!
}

ftl::plugin::core::ext_pdf()
{
        if ((ftl_state_external_viewer_mode == 1)) ; then
                ((ftl_state_pdf_preview_as_image)) && ftl::util::run_maximized mupdf "$ftl_state_current_path" || ftl::plugin::core::ext_pdf_vi
        elif ((ftl_state_external_viewer_mode == 3)) ; then
                ftl::util::run_maximized mupdf "$ftl_state_current_path"
        else
                mupdf "$ftl_state_current_path" 2>/dev/null &
        fi
}

ftl::plugin::core::ext_epub()
{
        if (( ftl_state_external_viewer_mode == 1 )) ; then
                ftl::util::run_maximized okular "$ftl_state_current_path"
        fi
}

ftl::plugin::core::ext_pdf_vi()
{
        ftl::cmd::edit_current "$("$ftl_gen_dir/pdf" "$ftl_state_current_path" "$ftl_cache_thumb_dir/pdf" 1)"
}

ftl::plugin::core::ext_text()
{
        ftl::prev::clear
        ftl::pane::split "$ftl_cfg_editor ${ftl_selection_current[@]@Q}" "33%" '-h -b' -R
        ftl_pane_preview_id=
}

ftl::plugin::core::ext_json()
{
        ftl::prev::clear
        $ftl_cfg_json_viewer "$ftl_state_current_path"
}

ftl::plugin::core::ext_scim()
{
        ftl::prev::clear
        exec 2>&9
        scim "${ftl_state_current_path@Q}"
        exec 2>"$ftl_state_session_dir/log"
        ftl::util::enter_alt_screen
}

ftl::plugin::core::pignore()
{
        ftl_preview_is_dir_ftl=
        ftl_preview_is_vim=
        ftl::plugin::core::ptype
}
ftl::plugin::core::plock()
{
        ftl::prev::show_in_vim "$ftl_state_session_dir/lock_preview/$ftl_state_current_path"
}

ftl::plugin::core::ptype()
{
        ftl::list::get_mime_type
        ftl::pane::split_for_preview "echo ${ftl_state_current_basename@Q} | lscolors ; \
                echo 'mime type: $ftl_state_current_mime_type' ; \
                echo -n 'file type: '; file -b ${ftl_state_current_path@Q} ; \
                stat -c %s ${ftl_state_current_path@Q} | numfmt --to=iec ; read -sn 100"
}

ftl::plugin::core::pcbr()
{
        local t
        t="$("$ftl_gen_dir/cbr" "$ftl_state_current_path" "$ftl_cache_thumb_dir/cbr" '' ONE)"
        ftl::log::debug "ftl::prev::dispatch file: $t"
        [[ -e "$t" ]] && { ftl::prev::show_image "$t" ; true ; } || ftl::plugin::core::ptype
}

ftl::plugin::core::pcbz()
{
        local t
        t="$("$ftl_gen_dir/cbz" "$ftl_state_current_path" "$ftl_cache_thumb_dir/cbz" '' ONE)"
        [[ -e "$t" ]] && { ftl::prev::show_image "$t" ; true ; } || ftl::plugin::core::ptype
}

ftl::plugin::core::pdir()
{
        local pdirv
        pdirv=(ftl::plugin::core::pdir_ftl ftl::plugin::core::pdir_du ftl::plugin::core::pdir_ls ftl::plugin::core::pdir_rmd ftl::plugin::core::pdir_exa ftl::plugin::core::pdir_image)
        (( ftl_state_alt_preview_mode != 0 )) && { [[ "${pdirv[$ftl_state_alt_preview_mode]}" ]] && ${pdirv[$ftl_state_alt_preview_mode]} ; } || ftl::plugin::core::pdir_def
}

ftl::plugin::core::pdir_def()
{
        local pdirv
        pdirv=(ftl::plugin::core::pdir_ftl ftl::plugin::core::pdir_du ftl::plugin::core::pdir_ls ftl::plugin::core::pdir_rmd ftl::plugin::core::pdir_exa ftl::plugin::core::pdir_image)
        echo "${ftl_state_other_session_dir:-$ftl_state_session_dir}" >"$ftl_state_shared_dir/fs"
        [[ "${pdirv[$ftl_state_dir_preview_mode]}" ]] && ${pdirv[$ftl_state_dir_preview_mode]} || ftl::plugin::core::pdir_ftl
}

ftl::plugin::core::pdir_ftl()
{
        if ((ftl_preview_is_dir_ftl)) && [[ $ftl_pane_preview_id ]] ; then
                tmux send -t "$ftl_pane_preview_id" 'r'
        else
                tmux selectp -t "$ftl_pane_self_id"
                ftl::pane::split_for_preview "ftl ${ftl_state_current_path@Q} $ftl_state_parent_dir 1"
                ftl_preview_is_dir_ftl=1
        fi
        true
}

ftl::plugin::core::pdir_du()
{
        ftl::pane::split_for_preview "$ftl_cfg_disk_usage_tool \"$ftl_state_current_path\" ; read -sn 1000"
        true
}
ftl::plugin::core::pdir_ls()
{
        ftl::pane::split_for_preview "ls -lh --group-directories-first --color=always \"$ftl_state_current_path\" ; read -sn 10"
        true
}
ftl::plugin::core::pdir_rmd()
{
        local m
        for m in "README.md" "README"
        do [[ -f "$ftl_state_current_path/$m" ]] && ftl::plugin::core::pmdd "$ftl_state_current_path/$m" && break
        done
}
ftl::plugin::core::pdir_exa()
{
        ftl::pane::split_for_preview "ftl_cfg_exa_colors='$ftl_cfg_exa_colors' exa \"$ftl_state_current_path\" $ftl_cfg_exa_options | $PAGER"
        true
}

ftl::plugin::core::pdir_image()
{
        local m
        ftl_preview_is_dir_ftl=
        m="$ftl_state_dir/montage/$ftl_state_current_path/montage.jpg"
        [[ -e "$m" ]] || {
                _ftl::list::print_header '' "$ftl_cfg_msg_montage"
                "$ftl_gen_dir/montage" "$ftl_state_dir" "$ftl_state_current_path"
                _ftl::list::print_header '' "$ftl_list_header_mode_glyphs"
        }
        ftl::prev::show_image "$m"
        true
}


ftl::plugin::core::ppipe()     { ftl::pane::split_for_preview "echo \"fifo (named pipe)\"; read -sn 100" ; }

ftl::plugin::core::phtml()
{
        ftl::prev::show_in_vim "$("$ftl_gen_dir/html" "$ftl_state_current_path" "$ftl_cache_thumb_dir/html")"
}
ftl::plugin::core::pimage()
{
        if ((ftl_state_alt_preview_mode)) ; then
                ftl::pane::split_for_preview "exiftool ${ftl_state_current_path@Q} | piper '^.*?:' blue | $ftl_cfg_markdown_pager ; read -sn1"
                ftl::pane::snapshot_geometry
        else
                ftl::prev::show_image "$ftl_state_current_path"
        fi
}

ftl::plugin::core::psvg()
{
        ftl::prev::show_image "$("$ftl_gen_dir/svg" "$ftl_state_current_path" "$ftl_cache_thumb_dir/svg")"
}
ftl::plugin::core::pgif()
{
        ftl::prev::show_image "$("$ftl_gen_dir/gif" "$ftl_state_current_path" "$ftl_cache_thumb_dir/gif")"
}

ftl::plugin::core::pmp3()
{
        local t
        ftl::plugin::core::pmlive || {
                t="$("$ftl_gen_dir/$ftl_state_current_extension" "$ftl_state_current_path" "$ftl_cache_thumb_dir/$ftl_state_current_extension")"
                ftl::pane::split_for_preview "$ftl_cfg_ansi_pager ${t@Q} ; read -sn1"
        }
}

ftl::plugin::core::pmedia()
{
        local t
        ftl::plugin::core::pmlive || {
                t="$("$ftl_gen_dir/$ftl_state_current_extension" "$ftl_state_current_path" "$ftl_cache_thumb_dir/$ftl_state_current_extension" '' ONE)"
                [[ -e "$t" ]] && { ftl::prev::show_image "$t" ; true ; } || ftl::plugin::core::ptype
        }
}

ftl::plugin::core::pmlive()
{
        local t
        ((ftl_state_alt_preview_mode)) && {
                ftl::cmd::kill_media_player
                t="$("$ftl_gen_dir/$ftl_state_current_extension" "$ftl_state_current_path" "$ftl_cache_thumb_dir/$ftl_state_current_extension")"
                ftl::pane::split_for_preview "cat ${t@Q} ; $ftl_cfg_live_preview_player ${ftl_state_current_path@Q}"
                true
        }
}

ftl::plugin::core::pmd()
{
        ftl::plugin::core::pmd_1 || ftl::plugin::core::pmd_2 || ftl::plugin::core::pmd_3 || ftl::plugin::core::pmd_def
        ftl_state_alt_preview_mode=0
}
ftl::plugin::core::pmd_1()
{
        if (( ftl_state_alt_preview_mode == 1 )) ; then
                ftl::pane::split_for_preview "$ftl_cfg_markdown_renderer_1 \"$ftl_state_current_basename\" | $ftl_cfg_markdown_pager"
                true
        fi
}
ftl::plugin::core::pmd_2()
{
        if (( ftl_state_alt_preview_mode == 2 )) ; then
                ftl::pane::split_for_preview "$ftl_cfg_markdown_renderer_2 \"$ftl_state_current_basename\" | $ftl_cfg_markdown_pager"
                true
        fi
}
ftl::plugin::core::pmd_3()
{
        if (( ftl_state_alt_preview_mode == 3 )) ; then
                ftl::prev::clear
                <<<"Y" mo --clear >/dev/null 2>&1
                _ftl::plugin::core::mo_vimb --no-open "$ftl_state_current_basename" &>/dev/null
                ftl_state_alt_preview_mode=0
                ftl::list::render
                true
        fi
}
ftl::plugin::core::pmd_def()   { $ftl_cfg_markdown_renderer_default \"$ftl_state_current_basename\" ; }

ftl::plugin::core::pmdd()
{
        local md="${1:-$ftl_state_current_path}"
        ftl::pane::split_for_preview "$ftl_cfg_markdown_dir_renderer \"$md\" "
}

ftl::plugin::core::ptext()     { ftl::prev::show_in_vim "$ftl_state_current_path" ; }

ftl::plugin::core::pansi()
{
        if ((!ftl_state_alt_preview_mode)) ; then
                ftl::pane::split_for_preview "$PAGER \"$ftl_state_current_path\""
        elif ((ftl_state_alt_preview_mode==1)) ; then
                ftl::pane::split_for_preview "$ftl_cfg_editor -R ${ftl_state_current_path@Q} -c AnsiEsc -c 'set nospell'"
        else
                ftl::pane::split_for_preview "ansi_show ${ftl_state_current_path@Q} | $PAGER "
        fi
}

ftl::plugin::core::pjson()
{
        ftl::pane::split_for_preview "$ftl_cfg_json_viewer \"$ftl_state_current_path\" ; read -sn100"
}
ftl::plugin::core::pyaml()
{
        ftl::pane::split_for_preview "$ftl_cfg_yaml_viewer \"$ftl_state_current_path\" ; read -sn100"
}

ftl::plugin::core::ppdf()
{
        if (( ftl_state_alt_preview_mode==2 || ftl_state_pdf_preview_as_image )) ; then
                ftl::plugin::core::ppdfpng
        else
                ftl::prev::show_in_vim "$("$ftl_gen_dir/pdf" "$ftl_state_current_path" "$ftl_cache_thumb_dir/pdf" "$ftl_state_alt_preview_mode")"
        fi
}

ftl::plugin::core::ppdfpng()
{
        local t
        t="$ftl_cache_thumb_dir/$ftl_state_current_extension/et_$(head -c50000 "$ftl_state_current_path" | md5sum | cut -f1 -d' ').png"
        [[ -f "$t" ]] || { mutool draw -o "$t" "$ftl_state_current_path" 1 2>/dev/null ; }
        ftl::prev::show_image "$t"
        true
}

ftl::plugin::core::pepub()
{
        if (( ftl_state_alt_preview_mode==2 || ftl_state_pdf_preview_as_image )) ; then
                ftl::plugin::core::pepubpng
        else
                ftl::prev::show_in_vim "$("$ftl_gen_dir/epub" "$ftl_state_current_path" "$ftl_cache_thumb_dir/epub" "$ftl_state_alt_preview_mode")"
        fi
}

ftl::plugin::core::pepubpng()
{
        local t
        t="$ftl_cache_thumb_dir/$ftl_state_current_extension/et_$(head -c50000 "$ftl_state_current_path" | md5sum | cut -f1 -d' ').png"
        [[ -f "$t" ]] || { mutool draw -o "$t" "$ftl_state_current_path" 1 2>/dev/null ; }
        ftl::prev::show_image "$t"
        true
}

ftl::plugin::core::pman()
{
        ftl::pane::split_for_preview "man \"$ftl_state_current_path\" ; read -sn 1000"
        true
}

ftl::plugin::core::pscim()
{
        ftl::pane::split_for_preview "scim \"$ftl_state_current_path\" | $PAGER ; read -sn100"
}
ftl::plugin::core::pasciio()
{
        ftl::pane::split_for_preview "asciio_to_text \"$ftl_state_current_path\" | $PAGER ; read -sn100"
}

ftl::plugin::core::pstl()
{
        ftl::prev::show_image "$("$ftl_gen_dir/stl" "$ftl_state_current_path" "$ftl_cache_thumb_dir/stl")"
}

ftl::plugin::core::pcomp()
{
        if [[ $ftl_state_current_extension == zip         ]] ; then
                ftl::plugin::core::pcomp unzip -l
        elif [[ $ftl_state_current_extension == rar         ]] ; then
                ftl::plugin::core::pcomp unrar list
        elif [[ $ftl_state_current_basename =~ \.tar$      ]] ; then
                ftl::plugin::core::pcomp tar --list         --verbose -f
        elif [[ $ftl_state_current_basename =~ \.tar\.gz$  ]] ; then
                ftl::plugin::core::pcomp tar --gzip  --list --verbose -f
        elif [[ $ftl_state_current_basename =~ \.tar\.bz2$ ]] ; then
                ftl::plugin::core::pcomp tar --bzip2 --list --verbose -f
        fi
}

ftl::plugin::core::pcomp()
{
        local fp
        ((ftl_state_alt_preview_mode)) && {
                fp="$ftl_state_session_dir/$ftl_state_current_basename.txt"
                [[ -e "$fp" ]] || timeout 1 "$@" "$ftl_state_current_basename" >"$fp"
                ftl::prev::show_in_vim "$fp"
        }
}

# needed when used as an fzf viewer from ftl
((!FTL_BOOTSTRAP_DONE)) && {
        : ${FTL_CFG:=$HOME/.config/ftl}
        source "$FTL_CFG/etc/core/ftl_setup"
        [[ "$1" ]] && ftl::plugin::fzf_pane_preview::pfzf "$1"
}

