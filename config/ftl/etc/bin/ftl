#!/bin/env bash
# ftl — terminal file manager, with live previews, hyperorthodox
# © Nadim Khemir 2020-2025, Artistic Licence 2.0
#
# This is the entry point. It defines the main ftl() function and the
# top-level listing functions. The bulk of the implementation is in
# etc/core/modules/.

# Run only inside tmux
if [[ -z "$TMUX" ]] ; then
        echo 'ftl: run me in tmux'
        exit 1
fi

: "${FTL_CFG:=$HOME/.config/ftl}"

ftl() {
        # Args: dir[/file], pfs, preview_ftl
        source "$FTL_CFG/etc/core/ftl_setup"
        ftl::log::trace "ftl() starting, args: $*"
        ftl::log::trace "ftl_setup sourced, ftl_state_session_dir=$ftl_state_session_dir"

        # Handle command-line options
        if [[ "$1" == '-f' ]] ; then
                ftl_state_parent_dir="$FTL_STATE_DIR/$$"
                mkdir -p "$ftl_state_parent_dir"
                ftl::log::wrap ftl::filt::load_external "$2"
                shift 2
        fi

        if [[ "$1" == '-s' ]] ; then
                ftl::sel::load_from_file "$@"
                shift 2
        fi

        if [[ "$1" == '-t' ]] ; then
                ftl::tab::load_from_file "$@"
                shift 2
        fi

        # Resolve the initial directory/file argument
        local dir= search=
        if [[ -n "$1" ]] ; then
                if [[ -d "$1" ]] ; then
                        dir="$1"
                elif [[ -f "$1" ]] ; then
                        ftl::util::parse_path "$1"
                        dir="$ftl_state_current_dir"
                        search="$ftl_state_current_basename"
                else
                        echo "ftl: '$1', no such path"
                        exit 1
                fi
        fi

        ftl::util::enter_alt_screen

        # Set up session directories
        if [[ -n "$2" ]] ; then
                # We're a child (preview) pane
                ftl_state_session_dir="$2/$$"
                ftl_state_parent_dir="$2"
                mkdir -p "$ftl_state_session_dir"
                touch "$ftl_state_session_dir/history"
        else
                # We're the main pane
                ftl_state_session_dir="$FTL_STATE_DIR/$$"
                ftl_state_parent_dir="$ftl_state_session_dir"
                ftl_pane_is_primary=1
                mkdir -p "$ftl_state_session_dir/prev"
                echo "$ftl_pane_self_id" >"$ftl_state_session_dir/pane"
        fi

        ftl_state_shared_dir="$ftl_state_parent_dir/prev"
        ftl_state_previous_pwd="$dir"

        # Initialize the main info file
        ftl_state_main_info_file_path="$(mktemp -p "$ftl_state_session_dir" ftl_main_info_XXXXXXX)"
        ftl::state::serialize_info "$ftl_state_main_info_file_path"

        # Either sync from parent (child pane) or start fresh (main pane)
        if [[ -n "$3" ]] ; then
                ftl_pane_is_child=1
                ftl_state_preview_pane_visible=0
                ftl_state_external_viewer_mode=0
                cd "$dir"
                ftl::log::trace "child pane, syncing from parent"
                ftl::prev::sync_and_dispatch
        else
                ftl::log::trace "main pane, opening dir=$dir search=$search"
                ftl::sel::sync_from_other_pane
                ftl::list::change_dir "$dir" "$search"
        fi

        ftl::log::trace "entering main loop"

        # The main loop
        while : ; do
                ftl::sel::sync_from_other_pane
                ftl::pane::check_resize
                ftl::time::tick

                # Get next input: either from pending queue or from the keyboard
                if [[ -n "$ftl_state_pending_input" ]] ; then
                        ftl_kbd_current_key="${ftl_state_pending_input:0:1}"
                        ftl_state_pending_input="${ftl_state_pending_input:1}"
                else
                        ftl::kbd::get_key "$ftl_cfg_key_timeout"
                fi

                ftl::log::wrap ftl::kbd::dispatch
                ftl::kbd::drain_input
                ftl_state_winch_pending=1
                ftl_kbd_current_key=
        done
}

ftl "$@"

# vim: set filetype=bash:
