#!/bin/bash

# pick from list of destinations where files passes as arguments should be moves

fzf_mv_rc="$HOME/.fzf_mv_rc"

declare -A extra_dest
while [[ "$1" == -d ]] ; do extra_dest["${2%/}"]=1 ; shift 2 ; done # lscolors remove trailing slash, store in the same format 

[[  "$1" ]] || { echo "fzf_mv: error: no files to move" >&2 ; exit 1 ; }
[[ -e "$fzf_mv_rc" ]] || { echo "fzf_mv: error: can't find '$fzf_mv_rc'" >&2 ; exit 1 ; }

fzf_opt="-p 90% --cycle --reverse --info=inline --color=hl+:214,hl:214 --tac -m --ansi"

to=$( { cat "$fzf_mv_rc" 2>&- ; ((${#extra_dest[@]})) && printf '%s\n' "${!extra_dest[@]}" ; } | awk '!seen[$0]++' | lscolors | fzf-tmux -0 -1 $fzf_opt)

[[ "$to" ]] && 
	{
	[[ ! -v 'extra_dest[$to]' ]] && { { echo "$to" ; cat "$fzf_mv_rc" 2>&- ; } | awk '!seen[$0]++' | sponge "$fzf_mv_rc" ; }
	[[ -d "$to" ]] || { echo "fzf_mv: error: '$to' is not a directory" >&2 ; exit 1 ; }
	mv "$@" "$to" 2>fzf_mv_log && rm fzf_mv_log || { echo "fzf_mv: error:" ; sed 's/^/\t/' "$PWD/fzf_mv_log" >&2 ; false ; }
	}

# vim: set filetype=bash :

