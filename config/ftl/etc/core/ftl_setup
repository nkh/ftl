#!/bin/env bash
# ftl_setup — initialization orchestrator
#
# This file is sourced by bin/ftl at startup. It sources all core modules
# in dependency order, sources the user's ftlrc, and initializes runtime
# state. No compatibility layers — all code uses namespaced names.
#
# © Nadim Khemir 2020-2025, Artistic Licence 2.0

export FTL_CFG

#----------------------------------------------------------------------------
# Source core modules (dependency order)
#----------------------------------------------------------------------------

source "$FTL_CFG/etc/core/modules/util.sh"
source "$FTL_CFG/etc/core/modules/log.sh"
source "$FTL_CFG/etc/core/modules/debug.sh"
source "$FTL_CFG/etc/core/modules/state.sh"
source "$FTL_CFG/etc/core/modules/keyboard.sh"
source "$FTL_CFG/etc/core/modules/selection.sh"
source "$FTL_CFG/etc/core/modules/tab.sh"
source "$FTL_CFG/etc/core/modules/pane.sh"
source "$FTL_CFG/etc/core/modules/filter.sh"
source "$FTL_CFG/etc/core/modules/list.sh"
source "$FTL_CFG/etc/core/modules/preview.sh"
source "$FTL_CFG/etc/core/modules/etag.sh"
source "$FTL_CFG/etc/core/modules/virtual.sh"
source "$FTL_CFG/etc/core/modules/mark.sh"
source "$FTL_CFG/etc/core/modules/time.sh"
source "$FTL_CFG/etc/core/modules/commands.sh"
source "$FTL_CFG/etc/core/modules/inline_rename.sh"

# Source the viewer dispatcher (defines ftl::prev::show_internal etc.)
# Set FTL_BOOTSTRAP_DONE first so viewers/core doesn't try to re-source ftl_setup
FTL_BOOTSTRAP_DONE=1
source "$FTL_CFG/etc/viewers/core"

#----------------------------------------------------------------------------
# Declare core associative arrays before ftlrc populates them
#----------------------------------------------------------------------------

declare -Ag ftl_kbd_command_to_key
declare -Ag ftl_kbd_bindings_display
declare -Ag ftl_kbd_trie
declare -Ag ftl_kbd_submode_handler
declare -Ag ftl_plugin_vfiles
declare -Ag ftl_plugin_vdirs
declare -Ag ftl_time_handlers
declare -Ag ftl_mark_session_marks

#----------------------------------------------------------------------------
# Source the user's ftlrc (or the default)
# ftlrc sets all ftl_cfg_* variables and calls ftl::kbd::bind
#----------------------------------------------------------------------------

source "$FTL_CFG/ftlrc" 2>&- || source "$FTL_CFG/etc/ftlrc"

#----------------------------------------------------------------------------
# Initialize runtime state
#----------------------------------------------------------------------------

# State directories
ftl_state_session_dir="$FTL_STATE_DIR/$$"
ftl_state_parent_dir="$ftl_state_session_dir"
ftl_state_other_session_dir="$ftl_state_session_dir"
ftl_state_shared_dir="$ftl_state_session_dir/prev"

# Compute this pane's tmux id
ftl_pane_self_id="$(ftl::pane::pid_to_id $$)"

# Pane state — must be initialized before any code uses them under set -u
ftl_pane_is_primary=0
ftl_pane_is_child=0
ftl_pane_preview_id=
ftl_pane_fixed_preview_id=
ftl_pane_shell_id=
ftl_pane_height=24
ftl_pane_width=80
ftl_pane_prev_width=80
ftl_pane_prev_height=24
ftl_pane_top=0
ftl_pane_window_width=80
ftl_pane_left=0
ftl_pane_preview_width=0
ftl_pane_session_shell_active=0
ftl_pane_inotify_pid=
ftl_pane_inotify_all_pids=()

# Initialize logging (after session dir is set)
ftl::log::init

# Selection state
ftl_selection_total_bytes=0
ftl_selection_revision=0

# Runtime associative arrays
declare -Ag ftl_state_cursor_memory
declare -Ag ftl_list_mime_cache
declare -Ag ftl_view_preview_ignore_exts
declare -Ag ftl_filter_listing_hide_exts
declare -Ag ftl_filter_listing_keep_exts
declare -Ag ftl_filter_listing_keep_exts_per_tab
declare -Ag ftl_view_vim_tail_commands
declare -Ag ftl_selection_tags
declare -Ag ftl_selection_class_index
declare -Ag ftl_state_child_env
declare -Ag ftl_list_dir_size_cache

# Raw-entry arrays (populated during directory scan)
declare -ag ftl_list_raw_entries
declare -Ag ftl_list_raw_paths
declare -Ag ftl_list_raw_names
declare -Ag ftl_list_raw_colors
declare -Ag ftl_list_raw_sizes
declare -Ag ftl_list_raw_relpath_len

# Initialize selection, path, and tab state
ftl_selection_current=()
ftl_state_current_path=
ftl_state_current_dir=
ftl_state_current_basename=
ftl_state_current_stem=
ftl_state_current_extension=
ftl_state_current_mime_type=
ftl_state_current_is_binary=0
ftl_state_current_file_description=
ftl_state_cursor_index=0
ftl_state_current_tab_index=0
ftl_state_previous_pwd=
ftl_state_custom_list=
ftl_state_quit_cancelled=0
ftl_state_pending_input=
ftl_state_winch_pending=0
ftl_state_search_string=
ftl_state_preview_callback=
ftl_state_montage_glyph=
ftl_state_external_viewer_mode=0
ftl_state_preview_pane_visible=${ftl_state_preview_pane_visible:-1}
ftl_state_alt_preview_mode=0
ftl_state_dir_preview_mode=0
ftl_state_show_size_mode=0
ftl_state_etag_enabled=0
ftl_tab_directories+=("$PWD")
ftl_tab_count=1
ftl::tab::init_defaults

# Initialize listing state (must be set before any render)
ftl_list_entry_count=0
ftl_list_entries=()
ftl_list_entry_colors=()
ftl_list_window_top=0
ftl_list_window_bottom=0
ftl_list_window_height=0
ftl_list_window_center=0
ftl_list_display_line_no=0
ftl_list_total_size=0
ftl_list_index_padding=1
ftl_list_first_file_index=
ftl_list_search_found_index=
ftl_list_header_total_count=
ftl_list_header_total_size=
ftl_list_quick_display_active=0
ftl_list_flip_index=0
ftl_list_current_flip_char=
ftl_list_path_separator=/
ftl_list_resolved_sort_type=0
ftl_list_resolved_sort_reversed=

# Initialize filter pipeline and virtual entries
ftl::filt::reset
ftl::plugin::virtual::reset

# Create named pipes for the listing pipeline
ftl::util::create_fifos 4 5 6

# Initialize redo-exclusion set
ftl::kbd::init_exclusions

# Initialize filter pipeline string
ftl::filt::init

# vim: set filetype=bash:
