# ftl_setup — initialization orchestrator
#
# This file is sourced by bin/ftl at startup. It:
#   1. Sources all the core modules in dependency order
#   2. Sets up a compatibility layer mapping old variable names to new ones
#   3. Sources the user's ftlrc (which uses old names)
#   4. Initializes the runtime state

export FTL_CFG

# Source the core modules in dependency order.
source "$FTL_CFG/etc/core/modules/util.sh"
source "$FTL_CFG/etc/core/modules/log.sh"
source "$FTL_CFG/etc/core/modules/debug.sh"
source "$FTL_CFG/etc/core/modules/state.sh"
source "$FTL_CFG/etc/core/modules/keyboard.sh"
source "$FTL_CFG/etc/core/modules/selection.sh"
source "$FTL_CFG/etc/core/modules/tab.sh"
source "$FTL_CFG/etc/core/modules/pane.sh"
source "$FTL_CFG/etc/core/modules/filter.sh"
source "$FTL_CFG/etc/core/modules/list.sh"
source "$FTL_CFG/etc/core/modules/preview.sh"
source "$FTL_CFG/etc/core/modules/etag.sh"
source "$FTL_CFG/etc/core/modules/virtual.sh"
source "$FTL_CFG/etc/core/modules/mark.sh"
source "$FTL_CFG/etc/core/modules/time.sh"
source "$FTL_CFG/etc/core/modules/commands.sh"

# Source the viewers (which define ftl::prev::show_internal etc.)
source "$FTL_CFG/viewers/core"

# Declare the core runtime associative arrays before ftlrc populates them.
declare -Ag ftl_kbd_command_to_key ftl_kbd_bindings_display ftl_kbd_trie \
    ftl_kbd_submode_handler ftl_plugin_vfiles ftl_plugin_vdirs \
    ftl_time_handlers ftl_mark_session_marks

#--- Compatibility layer -------------------------------------------------
# The ftlrc file uses the original (v1) variable and function names.
# We keep these working by:
#   - Letting ftlrc set the old names
#   - Then copying old-name values to new-name variables
#   - Defining old-name function aliases for the new functions
#
# This means the user's ftlrc continues to work unchanged, while the
# internal code uses the new namespaced names.

# Source the user's ftlrc (or the default if no user override).
# ftlrc sets old-name variables (KEY_TIMEOUT, EDITOR, etc.) and calls
# the old bind() function (which we alias to ftl::kbd::bind below).
source "$FTL_CFG/ftlrc" 2>&- || source "$FTL_CFG/etc/ftlrc"

# Map old-name config variables to new-name config variables.
# These are set by ftlrc and need to be visible to the new code.

