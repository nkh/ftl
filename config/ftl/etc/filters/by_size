[[ "$1" == reset ]] && : ||
{
	[[ "$1" == load ]] && [[ -e "$ftl_state_parent_dir/by_size" ]] && source "$ftl_state_parent_dir/by_size" ||
	{
		ftl::cmd::prompt 'ftl filter file min size: '
		ftl_min_size="${ftl_kbd_current_key:-0}"
		[[ "$ftl_min_size" =~ [0-9]+ ]] || ftl_min_size=0

		declare -p ftl_min_size >"$ftl_state_parent_dir/by_size"
	}

	ftl_filter_active_glyph="~"
}

ftl::plugin::by_size::filter()
{
	local -a file_data

	while IFS=$'\t' read -a file_data ; do
		{ [[ -d "${file_data[2]}" ]] || ((${file_data[0]} > ${ftl_min_size:-0})) ; } && \
			printf "%s\t%s\t%s\n" "${file_data[@]}"
	done
}

# Override the placeholder so the listing pipeline dispatches to this plugin.
ftl::filter::apply_external() { ftl::plugin::by_size::filter ; }

