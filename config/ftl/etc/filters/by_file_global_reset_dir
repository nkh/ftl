declare -g -A keep PWDS

[[ "$1" == reset ]] && { unset keep PWDS ; } ||
{
	[[ "$1" == load ]] && [[ -e "$ftl_state_parent_dir/by_file_global_reset_dir" ]] && source "$ftl_state_parent_dir/by_file_global_reset_dir" ||
	{
		for f in "${!keep[@]}" ; do [[ "$f" =~ "$ftl_state_current_tab_index-$PWD/" ]] && unset 'keep[$f]' ; done

		OIFS=$IFS
		IFS=$'\n'
		for file in $(\
						{ find -maxdepth 1 -type d -printf "%f\n" | grep -v '^\.$' | sort -u ; find -maxdepth 1 -type f -printf "%f\n" | sort -u ; } | \
						lscolors | fzf-tmux -p 80% --cycle -m --ansi --info=inline --layout=reverse --bind ctrl-s:select-all \
						)
			do
				keep["$PWD/$file"]=1
				PWDS[$PWD]=1
				ftl_filt_active_glyph="~"
			done
		IFS=$OIFS

		declare -p keep PWDS >"$ftl_state_parent_dir/by_file_global_reset_dir"
	}
}

ftl::plugin::by_file_global_reset_dir::filter()
{
	local file_data fn

	[[ ${PWDS["$PWD"]} == 1 ]] && {
		while read -r file_data ; do
			fn="${file_data#$'*\t'*$'\t'}"
			[[ ${keep["$PWD/$fn"]} == 1 ]] && echo "$file_data"
		done
	} || cat
}

# Override the placeholder so the listing pipeline dispatches to this plugin.
ftl::filter::apply_external() { ftl::plugin::by_file_global_reset_dir::filter ; }

