declare -g -A keep PWDR

[[ "$1" == reset ]] && { unset -v keep PWDR ; } ||
{
	[[ "$1" == load ]] && [[ -e "$ftl_state_parent_dir/by_all_files" ]] && source "$ftl_state_parent_dir/by_all_files" ||
	{
		OIFS=$IFS
		IFS=$'\n'

		ftl_filter_active_glyph="~"
		[[ "$PWDR" ]] && {
			OPWDR="$PWDR"

			[[ ${#PWD} -lt ${#PWDR} ]] && {
				PWDR="$PWD"

				last_component=

				while [[ "${OPWDR}" ]] ; do
					keep["$ftl_state_current_tab_index-$OPWDR"]=1
					[[ $last_component ]] && break
					OPWDR="${OPWDR%/*}"
					[[ "$OPWDR" == "" ]] && break
					[[ "$OPWDR" == "$PWD" ]] && break
					[[ "$OPWDR" == "/" ]] && last_component=1
				done
			}

		} || PWDR="$PWD"

		for file in $(\
						find -printf "%p\n" | grep -v '^\.$' | sed 's ^./  ' | sort -u | lscolors | \
						fzf-tmux -p 80% --cycle -m --ansi --info=inline --layout=reverse --bind ctrl-s:select-all \
						)
			do
				# keep all the path in between
				last_component=

				while [[ "${file}" ]] ; do
					keep["$ftl_state_current_tab_index-$PWD/$file"]=1
					[[ $last_component ]] && break
					file="${file%/*}"
					[[ "$file" =~ "/" ]] || last_component=1
				done
			done
		IFS=$OIFS

		declare -p keep PWDR >"$ftl_state_parent_dir/by_all_files"
	}
}

ftl::plugin::by_all_files::filter()
{
	local file_data fn

	[[ ${#PWD} -ge ${#PWDR} ]] && {
		while read -r file_data ; do
			fn="${file_data#$'*\t'*$'\t'}"
			[[ ${keep["$ftl_state_current_tab_index-$PWD/$fn"]} == 1 ]] && echo "$file_data"
		done
	} || cat
}

# Override the placeholder so the listing pipeline dispatches to this plugin.
ftl::filter::apply_external() { ftl::plugin::by_all_files::filter ; }

