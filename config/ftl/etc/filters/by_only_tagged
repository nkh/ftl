ftl_filt_active_glyph="~"

ftl::plugin::by_only_tagged::filter()
{
    local -a file_data

    while IFS=$'\t' read -a file_data ; do
        { [[ -d ${file_data[2]} ]] || [[ "${ftl_selection_tags[$PWD/${file_data[2]}]}" ]] ; } && \
            printf "%s\t%s\t%s\n" "${file_data[@]}"
    done
}

# Override the placeholder so the listing pipeline dispatches to this plugin.
ftl::filter::apply_external() { ftl::plugin::by_only_tagged::filter ; }

