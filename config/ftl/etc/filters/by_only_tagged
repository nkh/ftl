#! /bin/bash

ftag="~"

ftl_filter()
{
while IFS=$'\t' read -a file_data
	do 
		{ [[ -d ${file_data[2]} ]] || [[ "${tags[$PWD/${file_data[2]}]}" ]] ; } && printf "%s\t%s\t%s\n" "${file_data[@]}"
	done
}

# use in a stacked filter, and called as an external script not sourced, the tags are passed via the FTL_TAGS environment variable
[[ "${BASH_SOURCE[0]}" = "${0}" ]] && { eval "$FTL_TAGS" ; ftl_filter "$@" ; }  
true

