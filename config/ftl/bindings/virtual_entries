# example 2 using virtual entries to implement a save_as functionality

ftl::kbd::bind	leader_ftl	extra	"vf"	ftl::plugin::virtual_entries::add_save_as	"insert a virtual entry for save_as"

SAF='save_as.txt'

ftl::plugin::virtual_entries::add_save_as()
{
	ftl::plugin::virtual_entries::get_file_name
	ftl::plugin::virtual_entries::ventry_save_as
}

ftl::plugin::virtual_entries::get_file_name()
{
	local C

	gcn
	echo -ne "\e[H"
	tput cnorm
	stty echo
	C="$(ftl::cmd::prompt_with_history "name: ")"
	stty -echo
	tput civis
	[[ "$C" ]] && header '' "$ftl_list_header_mode_glyphs" && SAF="$C"
	ftl::list::render
}

ftl::plugin::virtual_entries::ventry_save_as()
{
	ftl::plugin::virtual::set_callbacks ftl::plugin::virtual_entries::virt_dirs_save_as ftl::plugin::virtual_entries::virt_files_save_as ftl::plugin::virtual_entries::virt_color ftl::plugin::virtual_entries::virt_prev ftl::plugin::virtual_entries::virt_key
	ftl::plugin::virtual::enable 1
	ftl_state_preview_callback="ftl::plugin::virtual_entries::ventry_save_as"
	ftl::list::change_dir '' "$SAF"
}

ftl::plugin::virtual_entries::virt_dirs_save_as() { : ; }
ftl::plugin::virtual_entries::virt_files_save_as() { echo "$SAF" ; }


