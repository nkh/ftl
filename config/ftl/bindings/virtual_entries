# example 1 inject two virtual directories and a virtual file in all directories
# show a ftl::prev::dispatch
# handle key presses

# callbacks

ftl::plugin::virtual_entries::virt_dirs_get()
{
	# return ftl::list::render of virtual directories, $PWD is set

	echo "VIRTUAL DIRECTORY 0"
	echo "VIRTUAL DIRECTORY ${#PWD}"
}

ftl::plugin::virtual_entries::virt_files_get()
{
	# return ftl::list::render of virtual files

	echo "virtual_file"
}

ftl::plugin::virtual_entries::virt_color()
{
	# colorize virtual entries

	local cfile

	((${#ftl_plugin_vfiles[@]} || ${#ftl_plugin_vdirs[@]})) && {
		while read cfile ; do
			((${#ftl_plugin_vfiles[$cfile]})) && echo -e "\e[4m$cfile\e[m" || {
				((${#ftl_plugin_vdirs[$cfile]})) && echo -e "\e[32m$cfile" || echo "$cfile"
			}
		done
	} || cat
}

ftl::plugin::virtual_entries::virt_prev()
{
	# show ftl::prev::dispatch for virtual entries

	((${#ftl_plugin_vdirs["$(basename "$ftl_state_current_path")"]})) && {
		ftl::pane::split_or_respawn "echo \"ftl virtual directory '$ftl_state_current_path'\"; read -sn 100"
		return 0
	}

	((${#ftl_plugin_vfiles["$(basename "$ftl_state_current_path")"]})) && {
		ftl::pane::split_or_respawn "echo \"ftl virtual file '$ftl_state_current_path'\"; read -sn 100"
		return 0
	}

	return 1
}

ftl::plugin::virtual_entries::virt_key()
{
	# handle key press for virtual entries, return 1 if not handled

	((${#ftl_plugin_vfiles[$(basename "$ftl_state_current_path")]} || ${#ftl_plugin_vdirs[$(basename "$ftl_state_current_path")]})) && {
		# update the ftl::prev::dispatch when a ENTER key is pressed

		[[ "$1" == ENTER ]] && {
			ftl::pane::split_or_respawn "echo \"ftl virtual entry: <ENTER>\" ; read -sn 100"
			keys_command= HAS_COUNT= ftl_kbd_count=
			return 0
		}
	} || return 1
}

# commands

ftl::plugin::virtual_entries::ventries_off()
{
	# turn injection off
	ftl::plugin::virtual::reset

	# don't show virtual entries in ftl::prev::dispatch pane
	ftl_state_preview_callback="ftl::plugin::virtual_entries::ventries_off"

	ftl::list::change_dir
}

ftl::plugin::virtual_entries::ventries_on()
{
	# turn injection on

	# register call backs
	ftl::plugin::virtual::set_callbacks ftl::plugin::virtual_entries::virt_dirs_get ftl::plugin::virtual_entries::virt_files_get ftl::plugin::virtual_entries::virt_color ftl::plugin::virtual_entries::virt_prev ftl::plugin::virtual_entries::virt_key

	# turn injection on
	ftl::plugin::virtual::enable 1

	# also show virtual entries in ftl::prev::dispatch pane
	ftl_state_preview_callback="ftl::plugin::virtual_entries::ventries_on"

	ftl::list::change_dir
}

ftl::plugin::virtual_entries::ventries_etag()
{
	ftl_etag_source_name="virtual"
	source "$FTL_CFG/etags/$ftl_etag_source_name"
	ftl_state_etag_enabled=1
	ftl::list::change_dir '' "$ftl_state_current_basename"
}  # ftl_etag_source_name synchs source with ftl::prev::dispatch

ftl::kbd::bind	leader_ftl	extra	"LEADER v v"	ftl::plugin::virtual_entries::ventries_on	"insert virtual entries"
ftl::kbd::bind	leader_ftl	extra	"LEADER v V"	ftl::plugin::virtual_entries::ventries_off	"removes virtual entries"
ftl::kbd::bind	leader_ftl	extra	"LEADER v e"	ftl::plugin::virtual_entries::ventries_etag	"show virtual entries etag"

