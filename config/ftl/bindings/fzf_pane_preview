
# an experimental fzf search with ftl::prev::dispatch in a ftl pane

ftl::plugin::ftl::plugin::fzf_pane_preview::fzf_pane_preview::previewd()
{
	local preview_path

	source '$FTL_CFG'/viewers/core "$ftl_state_current_basename"

	while read -r preview_path ; do
		if [[ "$preview_path" == previewd_shutdown ]] ; then
			ftl::prev::clear
			exit
		else
			ftl::plugin::fzf_pane_preview::pfzf "$preview_path"
		fi
	done
}

ftl::plugin::fzf_pane_preview::fzf_pane_preview()
{
	ftl::plugin::ftl::plugin::fzf_pane_preview::fzf_pane_preview::fzf_pane_preview_all 1
}

ftl::plugin::ftl::plugin::fzf_pane_preview::fzf_pane_preview::fzf_pane_preview_all()
{
	local fzf_choice

	mkapipe 10
	<&10 ftl::plugin::ftl::plugin::fzf_pane_preview::fzf_pane_preview::previewd &

	exec 2>&9

	# find all files and pass then to fzf, and declare a previewr

	# the previewer sets a few variable and sources 'viewers/core' which
	# detects that it was sourced directly and calls ftl_setup and then calls
	# ftl::plugin::fzf_pane_preview::pfzf which is defined below

	fzf_choice="$( \
		{ (( "$1" )) && { { fd -HI -d1 -td | sort ; fd -HI -d1 -tf -tl | sort ; } | sed 's/^.\///' ; } \
				|| { fd -HI -E'.git/*' | sed 's/^.\///' ; } ; } | \
		lscolors | \
				fzf \
						--ansi \
						-m \
						--expect=ctrl-t \
						--ftl::prev::dispatch 'echo {} >&10 ; read -sn 100' \
						--ftl::prev::dispatch-window='right:0%' \
						--cycle --reverse --info=inline
		)"

	echo previewd_shutdown >&10
	ftl::prev::clear

	if [[ "$fzf_choice" ]] ; then
		go_loop fzf "$fzf_choice"
		ftl::list::render
		true
	else
		tput civis
		ftl::prev::clear
		ftl::list::render
	fi

	exec 2>"$ftl_state_session_dir/log"
}

ftl::plugin::fzf_pane_preview::pfzf()
{
	# fzf ftl::prev::dispatch in ftl ftl::prev::dispatch pane, reusing the normal previewer

	# replace ftl::pane::split_or_respawn with ftl::pane::split_for_preview
	# ftl_view_fzf_as_viewer=1

	ftl_state_current_path="$(realpath "$1")"
	ftl_state_current_basename="$(basename "$1")"
	if [[ "$ftl_state_current_basename" =~ \. ]] ; then
		ftl_state_current_extension="${ftl_state_current_basename##*.}"
	else
		ftl_state_current_extension=
	fi

	# set ftl_state_parent_dir
	# fzf_viewer_fs=/tmp/ftl_view_fzf_as_viewer ; mkdir -p "$fzf_viewer_fs" ; ftl_state_parent_dir="$fzf_viewer_fs"

	# handle tmux "not cleaning" pane
	# tmux respawn-pane -k -t $ftl_pane_preview_id "for i in \$(seq 100) ; do echo -e '\e[30m.' ; done ; read -sn1"
	# sleep .02

	# use pdir_ls for directory
	[[ -d "$ftl_state_current_path" ]] && { pdir_ls ; return ; }

	# call the default previewers
	pviewers
}

ftl::kbd::ftl::kbd::bind ftl find           "/"     ftl::plugin::fzf_pane_preview::fzf_pane_preview        "find via fzf with pane ftl::prev::dispatch"
ftl::kbd::ftl::kbd::bind ftl search         gfp     ftl::plugin::fzf_pane_preview::fzf_pane_preview        "fzf with ftl::prev::dispatch in ftl::prev::dispatch pane"
ftl::kbd::ftl::kbd::bind ftl search         gfP     ftl::plugin::ftl::plugin::fzf_pane_preview::fzf_pane_preview::fzf_pane_preview_all    "fzf with ftl::prev::dispatch in ftl::prev::dispatch pane, sub directories"


