
# an experimental fzf search with preview in a ftl pane

ftl::plugin::fzf_pane_preview::previewd()
{
	local preview_path

	source "$FTL_CFG/etc/viewers/core"

	while read -r preview_path ; do
		if [[ "$preview_path" == previewd_shutdown ]] ; then
			ftl::prev::clear
			exit
		else
			ftl::plugin::fzf_pane_preview::pfzf "$preview_path"
		fi
	done
}

ftl::plugin::fzf_pane_preview::fzf_pane_preview()
{
	ftl::plugin::fzf_pane_preview::fzf_pane_preview_all 1
}

ftl::plugin::fzf_pane_preview::fzf_pane_preview_all()
{
	local fzf_choice

	ftl::util::create_fifos 10
	<&10 ftl::plugin::fzf_pane_preview::previewd &

	exec 2>&9

	# find all files and pass them to fzf, with a previewer

	fzf_choice="$( \
		{ (( "$1" )) && { { fd -HI -d1 -td | sort ; fd -HI -d1 -tf -tl | sort ; } | sed 's/^.\///' ; } \
				|| { fd -HI -E'.git/*' | sed 's/^.\///' ; } ; } | \
		lscolors | \
				fzf \
					--ansi \
					-m \
					--expect=ctrl-t \
					--preview 'echo {} >&10 ; read -sn 100' \
					--preview-window='right:0%' \
					--cycle --reverse --info=inline
		)"

	echo previewd_shutdown >&10
	ftl::prev::clear

	if [[ "$fzf_choice" ]] ; then
		go_loop fzf "$fzf_choice"
		ftl::list::render
		true
	else
		tput civis
		ftl::prev::clear
		ftl::list::render
	fi

	exec 2>"$ftl_state_session_dir/log"
}

ftl::plugin::fzf_pane_preview::pfzf()
{
	# fzf preview in ftl preview pane, reusing the normal previewer

	ftl_state_current_path="$(realpath "$1")"
	ftl_state_current_basename="$(basename "$1")"
	if [[ "$ftl_state_current_basename" =~ \. ]] ; then
		ftl_state_current_extension="${ftl_state_current_basename##*.}"
	else
		ftl_state_current_extension=
	fi

	# use pdir_ls for directory
	[[ -d "$ftl_state_current_path" ]] && { pdir_ls ; return ; }

	# call the default previewers
	ftl::plugin::core::pviewers
}

ftl::kbd::bind	ftl	find	"/"	ftl::plugin::fzf_pane_preview::fzf_pane_preview	"find via fzf with pane preview"
ftl::kbd::bind	ftl	search	gfp	ftl::plugin::fzf_pane_preview::fzf_pane_preview	"fzf with preview in preview pane"
ftl::kbd::bind	ftl	search	gfP	ftl::plugin::fzf_pane_preview::fzf_pane_preview_all	"fzf with preview in preview pane, sub directories"

