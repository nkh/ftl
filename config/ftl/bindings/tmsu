ftl::plugin::tmsu::tmsu_preview()
{
	local continuation_color tags_table all_tags files_tags tags_index
	local i file_name ftags tag file_tags

	continuation_color="$(echo -en '\e[90m')"
	tags_table=

	readarray -t all_tags < <(tmsu tags -1 --name=never $PWD/* | sed -e '/^$/d' | sort -u)
	readarray -t files_tags < <(tmsu tags "${ftl_list_entries[@]:$ftl_list_window_top:$ftl_list_window_height}" | sed -e 's/^.*: *//')

	tags_index=0
	for ((i=ftl_list_window_top ; i <= ftl_list_window_bottom ; i++)) ; do
		((i == ftl_state_cursor_index)) && tags_table+="$ftl_cfg_cursor_color_current" || tags_table+="$continuation_color"
		file_name="${ftl_list_entries[$i]}"

		ftags=(${files_tags[$tags_index]})
		((tags_index++))
		declare -A file_tags=()
		for tag in "${ftags[@]}" ; do file_tags[$tag]=1 ; done

		for tag in "${all_tags[@]}" ; do
			((${file_tags[$tag]})) && tags_table+="$tag\t" || tags_table+="⸱\t"
		done

		tags_table+="\n"
	done

	ftl::prev::clear
	ftl::pane::split_or_respawn "clear ; { echo ; echo -ne '$tags_table' | column -t -s $'\t' ; } | $ftl_cfg_markdown_pager ; read -sn 100"
}

ftl::plugin::tmsu::tmsu_tag()
{
	local tag_file row lines file_to_tag

	ftl::prev::clear

	tag_file="$(mktemp -p $ftl_state_session_dir ftl_tmsu_tag_XXXXXXX)"

	tmsu tags "${ftl_selection_current[@]}" 2>&- > "$tag_file"
	{ echo ; tmsu tags 2>&- | sort -u | sed 's/^/# /' ; } >> "$tag_file"

	vi +start +"norm! gg$" "$tag_file" && {
		readarray -t lines <"$tag_file"

		for row in "${lines[@]}" ; do
			[[ $row =~ ^([^:]+):(.*) ]] && {
				file_to_tag="${BASH_REMATCH[1]}"
				tmsu untag "$file_to_tag" $(tmsu tags -n never "$file_to_tag") 2>&-
				tmsu tag "$file_to_tag" ${BASH_REMATCH[2]} 2>&-
			}
		done
	}

	ftl::list::change_dir
}

ftl::plugin::tmsu::tmsu_tag_fzf()
{
	local new_tags F

	readarray -t new_tags < <(tmsu tags | fzf-tmux $ftl_cfg_fzf_popup_opts -0 -1 -m -p 30% -h 80%)

	for F in "${ftl_selection_current[@]}" ; do tmsu tag "$F" "${new_tags[@]}" 2>&- ; done

	ftl::list::change_dir
}

ftl::plugin::tmsu::tmsu_tag_scim()
{
	ftl::prev::clear
	# ftl::pane::split_or_respawn "$FTL_CFG/etc/bin/scim_tmsu" ; tmux selectp -t $ftl_pane_preview_id
	exec 2>&9
	"$FTL_CFG/etc/bin/scim_tmsu" "${ftl_selection_current[@]}"
	exec 2>"$ftl_state_session_dir/log"
	ftl::util::enter_alt_screen
}

ftl::plugin::tmsu::tmsu_mount()
{
	local tmsu_mp

	tmsu_mp="/tmp/ftl/mnt/tmsu_$$"

	[[ -e "$tmsu_mp" ]] || {
		mkdir -p "$tmsu_mp"
		tmsu mount "$tmsu_mp"
	}

	ftl::list::change_dir "$tmsu_mp"
}

ftl::plugin::tmsu::tmsu_filter()
{
	source "$FTL_CFG/filters/by_tag"
	ftl::list::change_dir '' "$ftl_state_current_basename"
}

ftl::plugin::tmsu::tmsu_filter_query()
{
	source "$FTL_CFG/filters/by_tag_query"
	ftl::list::change_dir '' "$ftl_state_current_basename"
}

ftl::plugin::tmsu::tmsu_table2()
{
	local all_tags files_and_tags file_and_tag continuation_color
	local file_tag_array tag

	readarray -t all_tags < <(tmsu files 2>&- | xargs tmsu tags --name=never 2>&- | tr ' ' '\n' | sed -e '/^$/d' | sort -u)

	readarray -t files_and_tags < <(tmsu files 2>&- | xargs tmsu tags 2>&-)

	continuation_color="$(echo -en '\e[90m')"

	for file_and_tag in "${files_and_tags[@]}" ; do
		declare -A file_tags=()

		file_tag_array=($file_and_tag)

		for tag in "${file_tag_array[@]:1}" ; do file_tags[$tag]="$tag" ; done

		echo -ne "${file_tag_array%%:}:\t"

		for tag in "${all_tags[@]}" ; do
			[[ -n "${file_tags[$tag]}" ]] && printf "$continuation_color${file_tags[$tag]}\t" || \
				printf -- "$continuation_color⸱\t"
		done

		echo
	done | sed 's@^.\/@'"$PWD"/'@' | sed 's@^..\{1,2\}\/@'"${PWD%/*}"/'@' | sort -ru | column -t
}

ftl::plugin::tmsu::tmsu_goto()
{
	ftl::util::go_loop f fzf "$(ftl::plugin::tmsu::tmsu_table2 | lscolors | fzf-tmux $ftl_cfg_fzf_popup_opts -m --ansi --expect=ctrl-t --preview 'lscolors {}' --preview-window noborder:wrap:down:4 | sed 's/:.*//')"
}

